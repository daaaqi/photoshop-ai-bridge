# Copy to .env and uncomment as needed.
# The API and host-bridge bind to 127.0.0.1 by default. Do not publish them to the internet.

# Port for the web UI (default: 18080)
# PORT=18080

# Host directory mounted into the container as /export (default: ~/Desktop)
# EXPORT_DIR=~/Desktop

# Absolute Mac path to that same folder (required for large PNG exports).
# Photoshop writes here directly; the container reads via the EXPORT_DIR mount.
# Example: HOST_EXPORT_DIR=/Users/you/Desktop
# HOST_EXPORT_DIR=

# Photoshop application name (default: Adobe Photoshop 2026)
# PS_APP="Adobe Photoshop 2026"

# Bridge port on host (default: 9090). Must match BRIDGE_URL in docker-compose.
# BRIDGE_PORT=9090

# Host-bridge bind address (default: 127.0.0.1)
# BRIDGE_BIND=127.0.0.1
